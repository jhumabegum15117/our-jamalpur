rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Security Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin Authority Check: verifies email, admins collection, or user role in Firestore
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jhumabegum15117@gmail.com' ||
        request.auth.token.email == 'masudrana15117@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // 3. User Profiles & RBAC
    // Every new user signup is strictly granted 'user' role. Self-elevation to 'admin' is prohibited.
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.role == 'user';
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isOwner(userId) && request.resource.data.role == resource.data.role)
      );
      allow delete: if isAdmin();
    }

    // 4. Admin Registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 5. Publicly readable district content - strictly writable/deletable by Admin only
    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ad_banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Marketplace Listings: public read, authenticated user can create, owner/admin can edit/delete
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // 7. Monetization & Ad booking requests
    match /monetization_requests/{requestId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 8. Health check test doc
    match /test/{docId} {
      allow read: if true;
    }
  }
}
